# ==============================================================================
# Colombo Tours — Environment Configuration Template
# Copy this file to `.env` for local development, or configure these keys
# in your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# --- Database (MongoDB Atlas) ---
# Required in production. Create a cluster on MongoDB Atlas and copy your SRV URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/colombo_tours?retryWrites=true&w=majority&appName=ColomboTours

# Local-only fallback: set to "true" ONLY if you want to preview locally without
# a MongoDB Atlas URI yet (runs an ephemeral in-memory MongoDB server locally).
# Ignored in production / Vercel deployments.
USE_IN_MEMORY_DB=false

# --- Authentication & Security ---
# Generate a strong random 64-character secret (e.g., `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Initial staff admin account bootstrapped automatically if no admin exists yet
ADMIN_EMAIL=admin@colombotours.lk
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Colombo Tours Staff

# --- Site & Fleet Bootstrap ---
# Optional: leave empty so enquiry buttons stay disabled until configured
# in the Admin Dashboard.
# WhatsApp: international digits only (e.g., 94771234567).
# Telegram: @username or international phone (e.g., ColomboTours or +94771234567).
# WeChat: WeChat ID or international phone (e.g., ColomboToursLK).
DEFAULT_WHATSAPP_NUMBER=
DEFAULT_TELEGRAM_HANDLE=
DEFAULT_WECHAT_ID=

# Automatically seed starter Sri Lankan luxury categories, services, and showcase
# vehicles once when the database is completely empty (set "false" to start blank).
SEED_ON_EMPTY=true

# --- Image Storage (Cloudinary Recommended — Serverless-Safe) ---
# Priority: Cloudinary -> Vercel Blob -> MongoDB Media (/api/media/:id) fallback.
# Configure EITHER CLOUDINARY_URL OR the 3 separate keys below from your Cloudinary Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=colombo-tours/vehicles
# Alternative single-line format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Optional alternative: Vercel Blob store token
BLOB_READ_WRITE_TOKEN=

# --- Server & CORS ---
PORT=5000
NODE_ENV=development
# Comma-separated allowed origins when frontend & API are hosted separately
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Optional) ---
# Leave empty when deployed together on Vercel (uses same-origin `/api`).
# Set only if hosting frontend separately from the API.
VITE_API_BASE_URL=
