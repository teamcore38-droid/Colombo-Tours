{
  "name": "colombo-tours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Colombo Tours — Luxury Car Rental & Chauffeur Fleet Website (MERN)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "backup": "npm run backup --workspace=server",
    "restore": "npm run restore --workspace=server",
    "reset-password": "node server/src/utils/resetAdminPasswordCli.js",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
